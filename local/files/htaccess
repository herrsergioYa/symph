#RewriteRule ^(.*)$ https://example.ru%{REQUEST_URI} [R=301,L]

# HTTPS =? on/off Or on only?
# HTTP_HOST = example.ru:443
# HTTP:PORT = 443
# REQUEST_URI - self-explanatory
# HTTP:Host - Forwarded by nginx (e.g. example.ru:443)
# HTTP:X-Forwarded-Proto - Forwarded by nginx (e.g. https)
# or
# HTTP:X-Forwarded-Schema - Forwarded by nginx (e.g. https)

# Переадресация с домена с WWW на домен без WWW
RewriteCond %{HTTP_HOST} ^www\.(.*) [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Переадресация с добавлением / в конце
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^.]+)(?<!/)$ /$1/ [R=301,L]
